#!/usr/bin/env python3
"""
consoleforge-tab - Control tabs in ConsoleForge

Usage:
  consoleforge-tab [options]              Open a new tab
  consoleforge-tab --close-self           Close the current tab (from within a session)
  consoleforge-tab --close --name NAME    Close a tab by name
  consoleforge-tab --wait-for-close ID    Block until the specified tab closes

Open options:
  --name NAME              Tab name (default: "Dynamic Session")
  --cwd PATH               Working directory
  --model MODEL            Claude model (opus, sonnet, haiku)
  --permission-mode MODE   Permission mode (manual, plan, acceptEdits, auto, dontAsk, bypassPermissions)
  --effort LEVEL           Effort level (low, medium, high, xhigh, max)
  --system-prompt TEXT     Replace system prompt
  --append-system-prompt TEXT  Append to system prompt
  --prompt TEXT             Initial prompt (visible, sent as first message)
  --mcp-config PATH        MCP config file path
  --flag FLAG              Additional CLI flag (can be repeated)
  --color HEX              Tab color (e.g. "#FF2D55")
  --continue               Continue previous session
  --no-group               Don't group under the spawning tab (when run inside a
                           ConsoleForge tab, new tabs group under it by default)

Target app (all modes):
  --app CHANNEL            Which install to talk to: "prod" (default) or "beta".
                           Run inside a ConsoleForge tab with no --app, the
                           command goes to the app that owns that tab, so beta
                           tabs spawn beta tabs and production stays untouched.

Close options:
  --close-self             Close the tab this command runs in (reads CONSOLEFORGE_TAB_ID)
  --close                  Close a tab (requires --name)
  --name NAME              Name of the tab to close (with --close)

Browser options — the app's own Safari panel (what the human is looking at).
These print a JSON reply and exit non-zero if the action failed:
  --browser-navigate URL   Point the in-app browser at a page. Returns once it loads.
  --browser-eval SCRIPT    Run JavaScript in the page and return its value
  --browser-screenshot [P] Write a PNG of the panel; prints the path it used
  --browser-scroll N       Scroll by N pixels (negative for up), or 'top' / 'bottom'

Browser options — a managed Chrome owned by this tab (a DIFFERENT browser):
  --browser                Start this tab's browser at launch, owned by the app, instead
                           of on first use. Every tab gets its own headless browser and
                           its chrome-devtools MCP already points at it, so this only
                           trades ~1GB up front for skipping Chrome's cold start — and
                           makes the browser app-owned, so --browser-info can see it.
  --browser-window [URL]   Open a real browser WINDOW owned by this tab (for a human to
                           look at or sign in to). The agent's own browser is headless.
  --browser-info           Print this tab's managed-browser ports as JSON, for pointing
                           chrome-devtools-mcp --browserUrl at this tab's own browser

Wait options:
  --wait-for-close ID      Block until the tab with the given ID closes, then print the event JSON
  --timeout SECONDS        Max time to wait (default: no timeout)

Examples:
  consoleforge-tab --name "Issue #42" --cwd ~/projects/myapp --prompt "Summarize issue 42"
  consoleforge-tab --close-self
  consoleforge-tab --close --name "Feature Work"
  consoleforge-tab --wait-for-close ABC-123-DEF
"""

import json
import os
import sys
import time
import signal

APP_SUPPORT_ROOT = os.path.expanduser("~/Library/Application Support")

# Application Support directory name per channel. These MUST match AppChannel.swift:
# production's is the historical literal "ConsoleForge" and can never be renamed.
CHANNEL_DIRS = {
    "prod": "ConsoleForge",
    "production": "ConsoleForge",
    "beta": "ConsoleForge Beta",
}

# Set by resolve_target(); every command read/write goes through these.
COMMANDS_DIR = None
EVENTS_DIR = None


def resolve_target(channel):
    """Pick which install to talk to and create its command/event dirs.

    Precedence: explicit --app > CONSOLEFORGE_APP_SUPPORT (exported by whichever
    ConsoleForge owns this tab) > production. The middle case is what makes a tab
    spawned inside beta land in beta: a single consoleforge-tab on PATH serves
    both apps, so the environment — not the file on disk — identifies the channel.
    """
    global COMMANDS_DIR, EVENTS_DIR

    if channel is not None:
        if channel not in CHANNEL_DIRS:
            print(
                f"Error: unknown --app '{channel}'. Use one of: "
                + ", ".join(sorted(CHANNEL_DIRS)),
                file=sys.stderr,
            )
            sys.exit(1)
        app_support = os.path.join(APP_SUPPORT_ROOT, CHANNEL_DIRS[channel])
    else:
        app_support = os.environ.get("CONSOLEFORGE_APP_SUPPORT") or os.path.join(
            APP_SUPPORT_ROOT, CHANNEL_DIRS["prod"]
        )

    COMMANDS_DIR = os.path.join(app_support, "commands")
    EVENTS_DIR = os.path.join(app_support, "events")
    os.makedirs(COMMANDS_DIR, exist_ok=True)
    os.makedirs(EVENTS_DIR, exist_ok=True)


def take_app_flag(args):
    """Pop `--app CHANNEL` out of args (valid in every mode) and return it."""
    if "--app" not in args:
        return args, None
    idx = args.index("--app")
    if idx + 1 >= len(args):
        print("Error: --app requires a channel (prod or beta)", file=sys.stderr)
        sys.exit(1)
    channel = args[idx + 1]
    return args[:idx] + args[idx + 2:], channel


def send_command(cmd):
    filename = f"{int(time.time())}-{os.getpid()}.json"
    filepath = os.path.join(COMMANDS_DIR, filename)
    tmppath = filepath + ".tmp"
    with open(tmppath, "w") as f:
        json.dump(cmd, f, indent=2)
    os.rename(tmppath, filepath)


def send_request(cmd, timeout=35):
    """Send a command that ANSWERS, and block for its reply.

    The rest of this script is fire-and-forget: drop a JSON file, the app picks it
    up, done. `--browser-eval` has to hand a value back, so these verbs carry a
    requestID and the app writes `responses/<id>.json`. Polling rather than kqueue
    because the wait is short and bounded — this is a request/response, not a tab
    that might stay open for an hour.
    """
    request_id = f"{int(time.time() * 1000)}-{os.getpid()}"
    cmd["requestID"] = request_id
    responses_dir = os.path.join(os.path.dirname(COMMANDS_DIR), "responses")
    os.makedirs(responses_dir, exist_ok=True)
    reply_path = os.path.join(responses_dir, f"{request_id}.json")

    send_command(cmd)

    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if os.path.exists(reply_path):
            try:
                with open(reply_path) as fh:
                    payload = json.load(fh)
            except (json.JSONDecodeError, OSError):
                # The app writes atomically, so this means a genuinely corrupt file
                # rather than a race. Do not spin on it.
                os.unlink(reply_path)
                print("Error: unreadable reply from ConsoleForge", file=sys.stderr)
                sys.exit(1)
            os.unlink(reply_path)
            return payload
        time.sleep(0.05)

    print("Error: ConsoleForge did not answer within %ds. Is the app running?" % timeout,
          file=sys.stderr)
    sys.exit(1)


def emit_reply(payload):
    """Print a reply and exit with a status the shell can branch on."""
    print(json.dumps(payload, indent=2))
    sys.exit(0 if payload.get("ok") else 1)


def wait_for_close(tab_id, timeout=None):
    """Block until an event file appears for the given tab ID."""
    event_file = os.path.join(EVENTS_DIR, f"{tab_id}.json")
    start = time.monotonic()

    # Check if event already exists (tab closed before we started waiting)
    if os.path.exists(event_file):
        return read_and_cleanup(event_file)

    # Use kqueue (macOS FSEvents via select.kqueue) for efficient watching
    try:
        return _wait_kqueue(tab_id, event_file, timeout, start)
    except (ImportError, OSError):
        # Fallback to polling
        return _wait_poll(event_file, timeout, start)


def _wait_kqueue(tab_id, event_file, timeout, start):
    """Watch the events directory using kqueue for efficient file notification."""
    import select

    dirfd = os.open(EVENTS_DIR, os.O_RDONLY)
    try:
        kq = select.kqueue()
        event = select.kevent(
            dirfd,
            filter=select.KQ_FILTER_VNODE,
            flags=select.KQ_EV_ADD | select.KQ_EV_CLEAR,
            fflags=select.KQ_NOTE_WRITE,
        )

        while True:
            remaining = None
            if timeout is not None:
                elapsed = time.monotonic() - start
                remaining = max(0, timeout - elapsed)
                if remaining <= 0:
                    print("Timeout waiting for tab to close", file=sys.stderr)
                    sys.exit(2)

            events = kq.control([event], 1, remaining)
            if os.path.exists(event_file):
                return read_and_cleanup(event_file)
    finally:
        os.close(dirfd)


def _wait_poll(event_file, timeout, start):
    """Fallback: poll for the event file every 500ms."""
    while True:
        if timeout is not None:
            elapsed = time.monotonic() - start
            if elapsed >= timeout:
                print("Timeout waiting for tab to close", file=sys.stderr)
                sys.exit(2)
        time.sleep(0.5)
        if os.path.exists(event_file):
            return read_and_cleanup(event_file)


def read_and_cleanup(event_file):
    """Read the event JSON, print it, clean up the file, and exit."""
    with open(event_file) as f:
        event = json.load(f)
    try:
        os.remove(event_file)
    except OSError:
        pass
    print(json.dumps(event, indent=2))
    return event


def main():
    args = sys.argv[1:]
    i = 0

    if any(a in ("-h", "--help") for a in args):
        print(__doc__)
        sys.exit(0)

    args, channel = take_app_flag(args)
    resolve_target(channel)

    # Handle --wait-for-close
    if "--wait-for-close" in args:
        wfc_idx = args.index("--wait-for-close")
        if wfc_idx + 1 >= len(args):
            print("Error: --wait-for-close requires a tab ID", file=sys.stderr)
            sys.exit(1)
        tab_id = args[wfc_idx + 1]
        timeout = None
        if "--timeout" in args:
            t_idx = args.index("--timeout")
            if t_idx + 1 < len(args):
                timeout = float(args[t_idx + 1])

        # Exit cleanly on SIGINT/SIGTERM
        signal.signal(signal.SIGINT, lambda *_: sys.exit(130))
        signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))

        event = wait_for_close(tab_id, timeout)
        # Exit with the tab's exit code if available
        exit_code = event.get("exitCode")
        sys.exit(exit_code if exit_code is not None else 0)

    # Drive the app's own Safari panel — the browser the human is looking at.
    #
    # Distinct from the managed-Chrome verbs below: this is the in-app WKWebView in the
    # slot layout, not a Chrome this tab owns. A session asked to "open this link in the
    # in-app browser" wants THIS. These are the only verbs here that answer, because
    # --browser-eval has to return a value; see send_request.
    if "--browser-navigate" in args:
        i = args.index("--browser-navigate")
        if i + 1 >= len(args) or args[i + 1].startswith("--"):
            print("Error: --browser-navigate needs a URL", file=sys.stderr)
            sys.exit(1)
        emit_reply(send_request({"action": "browser-navigate", "url": args[i + 1]}))

    if "--browser-eval" in args:
        i = args.index("--browser-eval")
        if i + 1 >= len(args):
            print("Error: --browser-eval needs a script", file=sys.stderr)
            sys.exit(1)
        emit_reply(send_request({"action": "browser-eval", "script": args[i + 1]}))

    if "--browser-screenshot" in args:
        i = args.index("--browser-screenshot")
        cmd = {"action": "browser-screenshot"}
        if i + 1 < len(args) and not args[i + 1].startswith("--"):
            cmd["path"] = os.path.abspath(os.path.expanduser(args[i + 1]))
        emit_reply(send_request(cmd))

    if "--browser-scroll" in args:
        i = args.index("--browser-scroll")
        if i + 1 >= len(args) or args[i + 1].startswith("--"):
            print("Error: --browser-scroll needs a pixel amount, or 'top'/'bottom'",
                  file=sys.stderr)
            sys.exit(1)
        target = args[i + 1]
        cmd = {"action": "browser-scroll"}
        if target == "top":
            cmd["scrollTo"] = 0
        elif target == "bottom":
            # Past any real page height; the browser clamps to the document.
            cmd["scrollTo"] = 99_999_999
        else:
            try:
                cmd["scrollBy"] = float(target)
            except ValueError:
                print("Error: --browser-scroll takes a number of pixels (negative scrolls "
                      "up), or 'top'/'bottom'", file=sys.stderr)
                sys.exit(1)
        emit_reply(send_request(cmd))

    # Hand the human a real browser WINDOW — a managed Chrome owned by this tab, which
    # is a different browser from the Safari panel above. This one is for signing in to
    # something, or for a page the agent's own headless browser cannot show anybody.
    if "--browser-window" in args:
        i = args.index("--browser-window")
        url = args[i + 1] if i + 1 < len(args) and not args[i + 1].startswith("--") else "about:blank"
        tab_id = os.environ.get("CONSOLEFORGE_TAB_ID")
        if not tab_id:
            print("Error: CONSOLEFORGE_TAB_ID not set. --browser-window only works inside a "
                  "ConsoleForge tab.", file=sys.stderr)
            sys.exit(1)
        send_command({"action": "browser-window", "tabID": tab_id, "url": url})
        print(f"Browser window requested: {url}")
        return

    # Print this tab's managed-browser ports, so a session can point
    # `chrome-devtools-mcp --browserUrl` at ITS OWN browser rather than spawning another.
    if "--browser-info" in args:
        tab_id = os.environ.get("CONSOLEFORGE_TAB_ID")
        if not tab_id:
            print("Error: CONSOLEFORGE_TAB_ID not set.", file=sys.stderr)
            sys.exit(1)
        meta = os.path.join(os.path.dirname(COMMANDS_DIR), "chrome", f"{tab_id}.json")
        if not os.path.exists(meta):
            print("No managed browser running for this tab.")
            sys.exit(1)
        with open(meta) as fh:
            print(fh.read())
        return

    # Check for close modes
    if "--close-self" in args:
        tab_id = os.environ.get("CONSOLEFORGE_TAB_ID")
        if not tab_id:
            print("Error: CONSOLEFORGE_TAB_ID not set. --close-self only works inside a ConsoleForge tab.", file=sys.stderr)
            sys.exit(1)
        send_command({"action": "close-tab", "tabID": tab_id})
        print("Close command sent to ConsoleForge")
        return

    is_close = "--close" in args
    if is_close:
        args = [a for a in args if a != "--close"]

    cmd = {"action": "close-tab" if is_close else "open-tab"}
    flags = []
    no_group = False

    while i < len(args):
        arg = args[i]
        if arg in ("-h", "--help"):
            print(__doc__)
            sys.exit(0)
        elif arg == "--name" and i + 1 < len(args):
            cmd["name"] = args[i + 1]; i += 2
        elif arg == "--cwd" and i + 1 < len(args):
            cmd["workingDirectory"] = os.path.expanduser(args[i + 1]); i += 2
        elif arg == "--model" and i + 1 < len(args):
            cmd["model"] = args[i + 1]; i += 2
        elif arg == "--permission-mode" and i + 1 < len(args):
            cmd["permissionMode"] = args[i + 1]; i += 2
        elif arg == "--effort" and i + 1 < len(args):
            cmd["effort"] = args[i + 1]; i += 2
        elif arg == "--system-prompt" and i + 1 < len(args):
            cmd["systemPrompt"] = args[i + 1]; i += 2
        elif arg == "--append-system-prompt" and i + 1 < len(args):
            cmd["appendSystemPrompt"] = args[i + 1]; i += 2
        elif arg == "--prompt" and i + 1 < len(args):
            cmd["initialPrompt"] = args[i + 1]; i += 2
        elif arg == "--mcp-config" and i + 1 < len(args):
            cmd["mcpConfigPath"] = args[i + 1]; i += 2
        elif arg == "--flag" and i + 1 < len(args):
            flags.append(args[i + 1]); i += 2
        elif arg == "--color" and i + 1 < len(args):
            cmd["tabColor"] = args[i + 1]; i += 2
        elif arg == "--browser":
            cmd["usesManagedBrowser"] = True
            i += 1
        elif arg == "--continue":
            cmd["continueSession"] = True; i += 1
        elif arg == "--no-group":
            no_group = True; i += 1
        else:
            print(f"Unknown option: {arg}", file=sys.stderr)
            sys.exit(1)

    if is_close:
        if "name" not in cmd:
            print("Error: --close requires --name to identify the tab", file=sys.stderr)
            sys.exit(1)
        send_command(cmd)
        print(f"Close command sent for tab: {cmd['name']}")
        return

    if flags:
        cmd["additionalFlags"] = flags

    # Tabs spawned from inside a ConsoleForge tab group under that tab (the app
    # ignores stale/closed parent ids). --no-group opts out.
    if not no_group:
        parent_id = os.environ.get("CONSOLEFORGE_TAB_ID")
        if parent_id:
            cmd["parentTabID"] = parent_id

    # Generate a tab ID so the caller can reference it for --wait-for-close
    import uuid
    tab_id = str(uuid.uuid4()).upper()
    cmd["tabID"] = tab_id

    send_command(cmd)
    print(f"tab-id: {tab_id}")


if __name__ == "__main__":
    main()
